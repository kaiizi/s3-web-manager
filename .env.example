# ── Application ──────────────────────────────────────────────────────────────
APP_USERNAME=admin
APP_PASSWORD=changeme

# JWT signing secret — must be at least 32 random characters
JWT_SECRET=change-this-to-a-random-32-char-secret!!

# Server listen port (default: 8080)
APP_PORT=8080

# ── Storage Provider ──────────────────────────────────────────────────────────
# Supported values: ceph
# Future: minio, s3
STORAGE_TYPE=ceph

# ── Ceph RGW ──────────────────────────────────────────────────────────────────
# RGW endpoint reachable from both the backend container AND the browser
# (browser needs direct access for Presigned URL uploads/downloads)
CEPH_ENDPOINT=http://172.16.31.61:8000

# Admin-level credentials (requires caps: buckets=*;users=*;usage=*;metadata=*)
CEPH_ACCESS_KEY=your-admin-access-key
CEPH_SECRET_KEY=your-admin-secret-key

# S3 region configured on the RGW (default: default)
CEPH_REGION=default
